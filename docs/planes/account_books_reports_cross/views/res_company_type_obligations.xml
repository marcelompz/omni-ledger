<odoo>

    <!-- tree view -->

    <record id="res_company_type_obligations_tree" model="ir.ui.view">
        <field name="name">res.company.type.obligations.tree</field>
        <field name="model">res.company.type.obligations</field>
        <field name="arch" type="xml">
            <tree editable="bottom" sample="1">
                <field name="name" required="1"/>
            </tree>
        </field>
    </record>

    <!-- window action -->

    <record id="res_company_type_obligations_action" model="ir.actions.act_window">
        <field name="name">Tipo de obligaciones</field>
        <field name="res_model">res.company.type.obligations</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Oops, nada a ser mostrado!</p>
        </field>
    </record>

    <!-- menu -->

    <menuitem
        id="res_company_type_obligations_menu"
        name="Tipo de obligaciones"
        action="account_books_reports_cross.res_company_type_obligations_action"
        parent="account_books_reports_cross.accounting_reports_menu"
        sequence="2"
    />

</odoo>
