<odoo>

    <!-- form view -->

    <record id="account_move_inherit_form" model="ir.ui.view">
        <field name="name">account.move.inherit.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">

            <!-- modificaciones en el boton cancelar -->
            <xpath expr="//header/button[@name='button_cancel' and contains(@attrs, 'move_type')]" position="replace">
                <button name="cross_button_cancel" string="Cancelar asiento" type="object" groups="account.group_account_invoice" data-hotkey="w"
                    attrs="{'invisible': ['|', '|', ('id', '=', False), ('state', '!=', 'draft'), ('move_type', '!=', 'entry')]}"/>
            </xpath>

            <!-- modificaciones en el boton cancelar -->
            <xpath expr="//header/button[@name='button_cancel' and contains(@attrs, 'move_type') and contains(@attrs, '==')]" position="replace">
                <button name="cross_button_cancel" string="Cancelar" type="object" groups="account.group_account_invoice" data-hotkey="w"
                    attrs="{'invisible': ['|', '|', ('id', '=', False), ('state', '!=', 'draft'), ('move_type', '==', 'entry')]}"/>
            </xpath>

            <!-- campos para el reporte contable -->
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="show_form145_reasons" invisible="1"/>
                <field name="receipt_type_id" options="{'no_create': True, 'no_open': True}" attrs="{'invisible': [('fiscal_document', '!=', True)]}"/>
                <!-- , 'required': [('fiscal_document', '=', True)] -->
                <field 
                    name="form120_id" 
                    options="{'no_create': True, 'no_open': True}" 
                    attrs="{
                        'invisible': ['|',
                            ('fiscal_document', '!=', True), 
                            ('is_income_revenue', '=', True)
                    ]}"
                />
                        <!-- , 
                        'required': ['|',
                            ('fiscal_document', '=', True),
                            ('is_income_revenue', '=', True)
                        ] -->
                <field 
                    name="form145_id" 
                    options="{'no_create': True, 'no_open': True}" 
                    attrs="{
                        'invisible': ['|',
                            ('fiscal_document', '!=', True), 
                            ('is_income_revenue', '=', True)
                    ]}"
                />
                        <!-- , 
                        'required': ['|',
                            ('fiscal_document', '=', True),
                            ('is_income_revenue', '=', True)
                        ] -->
                <field 
                    name="latam_doc_type_id" 
                    options="{'no_create': True, 'no_open': True}" 
                    attrs="{
                        'invisible': [
                            '|',
                            ('fiscal_document', '!=', True),
                            ('move_type', '!=', 'in_invoice')
                        ], 
                        'required': [
                            ('fiscal_document', '=', True),
                            ('move_type', '=', 'in_invoice'),
                        ]}"
                />
                <label for="receipt_period" attrs="{'invisible': [('is_income_revenue', '=', False)]}"/>
                <div class="d-flex">
                    <field name="is_income_revenue" invisible="1"/>
                    <field name="receipt_period" attrs="{'invisible': [('is_income_revenue', '=', False)], 'required': 1}" style="width: 120px;"/>
                        <span class="o_form_label mx-3 oe_edit_only">  </span>
                    <field name="invoice_tooltip" nolabel="1" class="fst-italic text-muted" attrs="{'invisible': [('is_income_revenue', '=', False)]}"/>
                </div>
                <field name="specify_document_type" attrs="{'invisible': [('is_income_revenue', '=', False)]}"/>
                <field name="form145_reasons_inclusion_id" options="{'no_create': True, 'no_open': True}" attrs="{'invisible': ['|', ('fiscal_document', '!=', True), ('show_form145_reasons', '!=', True)], 'required': [('fiscal_document', '=', True), ('show_form145_reasons', '=', True)]}"/>
                <field name="is_installment_payment" invisible="1"/>
            </xpath>

            <!-- boton para obtener datos del CDC -->
            <!-- <xpath expr="//header" position="inside">
                <button name="button_getinfo_from_cdc" type="object" string="Obtener info"/>
            </xpath> -->

            <!-- motivo de cancelacion -->
            <xpath expr="//notebook//page[@name='aml_tab']//field[@name='line_ids']" position="after">
                <group>
                    <field name="books_reports_cancel_reason" attrs="{'invisible': [('state', '=', 'cancel')]}"/>
                </group>
            </xpath>

            <!-- Numero de cuotas en caso de ser a credito -->
            <!-- <xpath expr="//div[@class='d-flex' and //field[@name='invoice_payment_term_id']]" position="inside"> -->
            <xpath expr="//field[@name='invoice_payment_term_id']" position="after">
                <label for="installment_payment_qty" string="Cuotas" attrs="{'invisible': [('is_installment_payment', '=', False)]}" />
                <field name="installment_payment_qty" 
                    attrs="{'invisible': [('is_installment_payment', '=', False)]}" 
                    placeholder="Número de cuotas" 
                    required="1"/>
            </xpath>

            <!-- Timbrado de compra y validacion -->
            <xpath expr="//field[@name='invoice_number']" position="before">
                <field 
                    name="in_invoice_stamped" 
                    attrs="
                    {'invisible': ['|',
                        ('move_type', '!=', 'in_invoice'),
                        ('is_income_revenue', '=', True)
                    ], 
                    'readonly': [
                        ('state','!=','draft')
                    ]
                }"/>
                <field 
                    name="in_invoice_date_due" 
                    attrs="
                    {'invisible': ['|',
                        ('move_type', '!=', 'in_invoice'),
                        ('is_income_revenue', '=', True)
                    ], 
                    'readonly': [
                        ('state','!=','draft')
                    ]
                }"/>
                <field name="expired_stamp_alert" invisible="1"/>
            </xpath>

            <!-- Alerta de vencimiento de timbrado -->
            <xpath expr="//sheet" position="before">
                <div 
                    role="alert" 
                    class="alert alert-danger oe_edit_only text-center" 
                    style="height:48px; margin-bottom:1px;"
                    attrs="{'invisible': [('expired_stamp_alert', '!=', True)]}">
                    ¡El timbrado de compra se encuentra vencido!
                </div>
            </xpath>
        
        </field>
    </record>

    <!-- tree view out_invoice-->
    <record id="account_move_inherit_out_invoice_tree" model="ir.ui.view">
        <field name="name">account.move.inherit.tree</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree" />
        <field name="arch" type="xml">

            <xpath expr="//tree//header" position="inside">
                <button name="accounts_receivable_payable_report" type="object" string="Informe a cobrar"/>
            </xpath>
        
        </field>
    </record>

    <!-- tree view in_invoice-->
    <record id="account_move_inherit_in_invoice_tree" model="ir.ui.view">
        <field name="name">account.move.inherit.tree</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree" />
        <field name="arch" type="xml">

            <xpath expr="//tree//header" position="inside">
                <button name="accounts_receivable_payable_report" type="object" string="Informe a pagar"/>
            </xpath>
        
        </field>
    </record>

</odoo>
