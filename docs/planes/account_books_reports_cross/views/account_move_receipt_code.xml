<odoo>

    <!-- tree view -->

    <record id="account_move_receipt_code_tree" model="ir.ui.view">
        <field name="name">account.move.receipt.code.tree</field>
        <field name="model">account.move.receipt.code</field>
        <field name="arch" type="xml">
            <tree editable="bottom" sample="1">
                <field name="code"/>
                <field name="name"/>
                <field name="type_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"/>
            </tree>
        </field>
    </record>

    <!-- window action -->

    <record id="account_move_receipt_code_action" model="ir.actions.act_window">
        <field name="name">Código tipo de comprobante</field>
        <field name="res_model">account.move.receipt.code</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Oops, nada a ser mostrado!</p>
        </field>
    </record>

    <!-- menu -->

    <menuitem
        id="account_move_receipt_code_menu"
        name="Código tipo de comprobante"
        action="account_books_reports_cross.account_move_receipt_code_action"
        parent="account_books_reports_cross.accounting_reports_menu"
        sequence="3"
    />

</odoo>
