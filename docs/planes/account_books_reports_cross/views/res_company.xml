<odoo>

    <!-- form view -->

    <record id="res_company_inherit_form" model="ir.ui.view">
        <field name="name">res.company.inherit.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page name="accounting_py" string="Contabilidad Py.">
                    <group>
                        <group>
                            <field name="legal_personality_id" options="{'no_create': 1}"/>
                            <field name="type_obligations_id" options="{'no_create': 1}" widget="many2many_tags"/>
                            <field name="accountant_identifier_id" options="{'no_create': 1}"/>
                            <field name="legal_representative_id" options="{'no_create': 1}"/>
                        </group>
                    </group>
                    <group name="economic_activity" string="Actividad económica">
                        <field name="economic_activity_ids" nolabel="1" colspan="2">
                            <tree editable="bottom">
                                <field name="code" required="1"/>
                                <field name="name" required="1"/>
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath>
        
        </field>
    </record>

</odoo>
